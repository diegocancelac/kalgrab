{
  "name": "kalgrab",
  "description": "Download videos from Kaltura players",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "check:manifest": "node scripts/check-manifest.ts",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
